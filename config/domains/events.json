{
  "schemaVersion": 1,
  "id": "events",
  "branding": {
    "appName": "CrowdGuard",
    "tagline": "Event incident response · demo",
    "seedColor": "#7C3AED",
    "icon": "stadium"
  },
  "map": {
    "provider": "openstreetmap",
    "tileUrl": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
    "attribution": "© OpenStreetMap contributors",
    "initialLat": 44.4268,
    "initialLng": 26.1025,
    "initialZoom": 14.5,
    "maxZoom": 19
  },
  "features": {
    "rewards": true,
    "gpsMap": true,
    "photo": true,
    "accessibility": true,
    "history": true,
    "demoReset": true
  },
  "quorum": {
    "strategy": "fixed",
    "minimum": 1,
    "fixed": 1
  },
  "rewards": {
    "strategy": "rule_based",
    "attendedPoints": 1,
    "resolvedBonus": 5,
    "deniedPoints": 0,
    "pointsLabel": "CREDITE",
    "reportPoints": 2
  },
  "notifications": {
    "roles": [
      "crew",
      "dispatcher"
    ],
    "scope": "primary_departments"
  },
  "demo": {
    "seedTickets": 3,
    "resetEnabled": true
  }
}
