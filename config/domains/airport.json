{
  "schemaVersion": 1,
  "id": "airport",
  "branding": {
    "appName": "Wingman",
    "tagline": "Airport incident response · demo",
    "seedColor": "#1D4E89",
    "icon": "flight_takeoff"
  },
  "map": {
    "provider": "openstreetmap",
    "tileUrl": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
    "attribution": "© OpenStreetMap contributors",
    "initialLat": 44.3189,
    "initialLng": 23.8864,
    "initialZoom": 15.5,
    "maxZoom": 19
  },
  "features": {
    "rewards": true,
    "gpsMap": true,
    "photo": true,
    "accessibility": true,
    "history": true,
    "demoReset": true
  },
  "quorum": {
    "strategy": "one_per_primary_department",
    "minimum": 1,
    "fixed": 2
  },
  "rewards": {
    "strategy": "rule_based",
    "attendedPoints": 2,
    "resolvedBonus": 10,
    "deniedPoints": 0,
    "pointsLabel": "PUNCTE",
    "reportPoints": 3
  },
  "notifications": {
    "roles": [
      "crew",
      "dispatcher"
    ],
    "scope": "primary_departments"
  },
  "demo": {
    "seedTickets": 5,
    "resetEnabled": true
  }
}
