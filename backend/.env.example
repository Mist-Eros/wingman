# ---------------------------------------------------------------------------
# backend/.env.example
#
# This project intentionally does NOT load .env files (no extra dependency).
# Set these in the shell before `run.ps1`, e.g.:
#
#   $env:OLLAMA_MODEL = 'llama3.1:8b'
#   .\run.ps1
#
# run.ps1 / run_insecure.ps1 provide sane defaults for everything below.
# ---------------------------------------------------------------------------

# Bearer token for /api/* and /ws. Must match the Flutter --dart-define=API_TOKEN.
API_TOKEN=demo-token

# --- Ollama -----------------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
# Pull once:  ollama pull qwen2.5:1.5b   (fast on CPU/GPU; 7b if you have time)
OLLAMA_MODEL=qwen2.5:1.5b
# Hard timeout for one classification (cold load can take longer; warm-up helps)
OLLAMA_TIMEOUT=25

# --- classification policy --------------------------------------------------
# Below this confidence the ticket waits in the dispatcher 5-second window.
CONFIDENCE_THRESHOLD=0.65
OVERRIDE_WINDOW_SECONDS=5

# --- crew resolution --------------------------------------------------------
# Legacy fallback; active quorum comes from DOMAIN_CONFIG (profile file).
RESOLVE_QUORUM=2

# --- speech-to-text (voice reporter flow) -----------------------------------
# Local faster-whisper; no cloud dependency.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Reject oversized audio uploads (bytes); the app records short clips.
MAX_AUDIO_BYTES=26214400

# --- dev conveniences -------------------------------------------------------
# Exposes POST /api/dev/reset (clears the in-memory store between rehearsals).
ENABLE_DEV_RESET=1

# --- application profile ---------------------------------------------------
# Same JSON file the Flutter app uses (branding, features, rewards, quorum).
# Leave unset for config/domains/airport.json.
# DOMAIN_CONFIG=config/domains/airport.json

# Optional: override the generated catalog path (used by tests).
# TAXONOMY_PATH=C:\path\to\backend\taxonomy.json
